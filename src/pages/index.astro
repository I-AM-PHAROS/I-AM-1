---
import fs from 'fs';
import path from 'path';

const filePath = path.resolve('./runtime/index.md');
const content = fs.readFileSync(filePath, 'utf-8');
---

<html>
  <head>
    <title>I-AM-1</title>
  </head>
  <body>
    <div style="max-width: 800px; margin: 40px auto; font-family: sans-serif;">
      <div innerHTML={content}></div>
    </div>
  </body>
</html>